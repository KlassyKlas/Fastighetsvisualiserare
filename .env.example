# Mapbox (required for frontend)
VITE_MAPBOX_TOKEN=your_mapbox_access_token_here

# Backend API URL (frontend connects here)
VITE_API_URL=http://localhost:8000

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fastighetsvisualiserare

# Trafikverket Open API
TRAFIKVERKET_API_KEY=your_trafikverket_api_key_here

# CORS origins (JSON array)
CORS_ORIGINS=["http://localhost:5173"]

# Optional: Lantmäteriet API
LANTMATERIET_API_KEY=

# Optional: Additional data sources can be added here
