# Miljövariabler för `docker compose --profile full` (kopiera till .env).
# För lokal utveckling: se backend/.env.example och frontend/.env.example.

# API-nyckel från https://data.trafikverket.se (krävs för synkronisering)
TRAFIKVERKET_API_KEY=

# Mapbox-token — bakas in i frontend-imagen vid bygge
VITE_MAPBOX_TOKEN=
