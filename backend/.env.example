# Kopiera till .env och fyll i.

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/fastighetsvisualiserare

# API-nyckel från https://data.trafikverket.se (krävs för synkronisering)
TRAFIKVERKET_API_KEY=

# Valfritt: tillåtna CORS-origins som JSON-lista
# CORS_ORIGINS=["http://localhost:5173"]

# Valfritt: sätts denna krävs headern X-API-Key för skrivande anrop
# API_WRITE_KEY=

# Valfritt: OAuth2-uppgifter från Lantmäteriets API-portal
# (apimanager.lantmateriet.se, konsumentkonto via Geotorget).
# Utan dessa hämtas detaljplaner via den publika sökproxyn.
# LANTMATERIET_CONSUMER_KEY=
# LANTMATERIET_CONSUMER_SECRET=
