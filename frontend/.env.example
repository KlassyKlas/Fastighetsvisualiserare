# Kopiera till .env och fyll i.

# Mapbox-token (obligatorisk för kartan): https://account.mapbox.com/access-tokens/
VITE_MAPBOX_TOKEN=

# Bas-URL till backend-API:t. Lämna tom för relativa anrop via Vites
# dev-proxy respektive nginx i Docker. Sätt t.ex. http://localhost:8000
# bara om frontenden servas utan proxy.
VITE_API_URL=
